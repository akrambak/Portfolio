# Runtime env for the VPS. Copy the values you need into
#
#   /home/bak-dev/apps/portfolio/shared/.env.production   (chmod 600)
#
# which remote-activate.sh symlinks into every release, so it survives deploys
# and rollbacks. The standalone Next server loads it from its cwd at startup.
#
# NEXT_PUBLIC_* does NOT belong here: those are inlined into the JS bundle by
# `next build` and setting them at runtime has no effect. See docs/DEPLOYMENT.md.
#
# Every value below has a working default for this box (src/lib/mail.ts), so an
# empty .env.production still delivers mail. Set them to override.

# --- Contact form delivery ---------------------------------------------------

# Where enquiries land. Defaults to site.email in src/config/site.ts.
CONTACT_TO=me@bak-dev.com

# Envelope sender. MUST be an address on the site's own domain — never the
# visitor's, which would fail SPF/DMARC and can be rejected outright. The
# visitor's address is put in Reply-To instead.
# Defaults to "Portfolio <noreply@<site.url host>>".
CONTACT_FROM=Portfolio <noreply@bak-dev.com>

# The MTA. The default is the Postfix this box already runs: one loopback hop,
# then local delivery, because bak-dev.com's MX is this same machine.
SMTP_HOST=127.0.0.1
SMTP_PORT=25

# Only needed for an authenticated relay. Leave both unset for local Postfix —
# it accepts loopback mail without credentials.
#SMTP_HOST=mail.bak-dev.com
#SMTP_PORT=587
#SMTP_USER=noreply@bak-dev.com
#SMTP_PASS=

# Implicit TLS. Defaults to true only on port 465; other ports use STARTTLS
# opportunistically.
#SMTP_SECURE=false

# Certificate verification. Defaults to off for loopback (a cert buys nothing on
# a hop that never leaves the machine, and Virtualmin's Postfix commonly presents
# a self-signed one) and on for every other host. Do not switch this off for a
# remote relay.
#SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Meta Conversions API (server-side lead reporting) -----------------------

# Reports each delivered enquiry to Meta from the server, deduplicated against the
# browser Pixel by event_id (src/lib/metaCapi.ts). Only for visitors who accepted
# marketing cookies. Leave both unset and nothing is sent.
#
# Events Manager -> your Pixel -> Settings -> Conversions API -> Generate access token.
#META_PIXEL_ID=
#META_CAPI_TOKEN=

# Routes events to Events Manager -> Test Events instead of live data. Remove once
# the Test Events tab shows the Lead arriving.
#META_TEST_EVENT_CODE=TEST12345

# --- Email open tracking (the /px endpoint) ----------------------------------

# Powers the 1x1 pixel in Career-OS upgrade proposals. The pixel at
# /px/o/<token>.gif records an open; Career-OS reads them back from
# /px/opens.json with this bearer token (src/app/px/**, src/lib/tracking.ts).
#
# Leave TRACKING_API_KEY unset and the pixel still serves the GIF, but
# /px/opens.json always answers 401 — so the opens are never exposed by an
# unconfigured deploy. Set it to a long random secret, shared with Career-OS's
# own .env (TRACKING_API_KEY there must match). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#TRACKING_API_KEY=

# Where opens are logged (one JSON line per hit). MUST be set in production, to a
# path under shared/ — the default lands inside the release tree, which a later
# deploy prunes, silently losing every open. shared/ survives deploys and
# rollbacks (see docs/DEPLOYMENT.md). The server creates the directory.
#TRACKING_STORE=/home/bak-dev/apps/portfolio/shared/data/opens.jsonl
