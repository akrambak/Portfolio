# Local deploy config for scripts/deploy-local.sh (npm run deploy:local).
# Copy to .env.deploy (gitignored) and adjust. CI uses repo variables/secrets
# with these same names instead of this file.

# SSH target: the Virtualmin domain user, not root.
VPS_HOST=bak-dev.com
VPS_USER=bak-dev
VPS_PORT=22

# The deploy key. Omit to use your default ssh-agent identity.
SSH_KEY=~/.ssh/portfolio_deploy

# Release root on the VPS. MUST be outside public_html.
APP_DIR=/home/bak-dev/apps/portfolio

# PM2 process name and the loopback port Apache proxies to.
# These match the app that is already live - a deploy takes it over.
APP_NAME=portfolio
PORT=3100

# Inlined into the bundle at build time. Changing it requires a rebuild.
NEXT_PUBLIC_SITE_URL=https://bak-dev.com
