{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3210}",
    "dev:turbo": "next dev --turbopack -p ${PORT:-3210}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "start:3100": "next start -p 3100",
    "preview": "next build && next start -p ${PORT:-3211}",
    "package": "bash scripts/package-release.sh",
    "deploy:local": "bash scripts/deploy-local.sh",
    "pm2:status": "PM2_HOME=/home/bak-dev/.pm2 pm2 list",
    "pm2:logs": "PM2_HOME=/home/bak-dev/.pm2 pm2 logs portfolio --lines 50",
    "lint": "node scripts/check-messages.mjs && next lint"
  },
  "dependencies": {
    "framer-motion": "^12.9.4",
    "gray-matter": "^4.0.3",
    "next": "15.3.1",
    "next-intl": "^4.14.1",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
